# Copy to .env and fill in. .env is git-ignored and must never be committed.

# --- LLM provider (Groq) ---
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# --- Application ---
# "groq" for real calls, "stub" for deterministic offline runs and tests
LLM_PROVIDER=groq

# Minimum retrieval score required to attempt an answer.
# Below this the assistant abstains before any LLM call is made.
RETRIEVAL_MIN_SCORE=0.15

# Directory holding the synthetic policy corpus
POLICY_DIR=policies

# Base URL the Streamlit UI uses to reach the API
API_BASE_URL=http://127.0.0.1:8000
