# Copy to .env and fill in. .env is git-ignored and must never be committed.

# --- LLM provider (Groq) ---
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=openai/gpt-oss-120b

# --- LLM provider (Nebius AI Studio, OpenAI-compatible) ---
# An alternative provider behind the same abstraction. Switch with LLM_PROVIDER.
NEBIUS_API_KEY=your-nebius-api-key-here
NEBIUS_MODEL=meta-llama/Llama-3.3-70B-Instruct
NEBIUS_BASE_URL=https://api.studio.nebius.com/v1

# --- Application ---
# "groq" or "nebius" for real calls, "stub" for deterministic offline runs and tests
LLM_PROVIDER=groq

# How many policy sections may be handed to the agents as evidence.
RETRIEVAL_MAX_RESULTS=6

# Minimum retrieval score required to attempt an answer.
# Below this the assistant abstains before any LLM call is made.
RETRIEVAL_MIN_SCORE=0.15

# Directory holding the synthetic policy corpus
POLICY_DIR=data

# Base URL the Streamlit UI uses to reach the API
API_BASE_URL=http://127.0.0.1:8000

# --- Observability ---
# Structured JSONL audit trail. Never contains question text, answers or keys.
OBSERVABILITY_ENABLED=true
OBSERVABILITY_FILE=logs/events.jsonl
